<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My E-Commerce Shop</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f5f5;
}

header{
    background:#007bff;
    color:white;
    padding:20px;
    text-align:center;
}

nav{
    background:#333;
    text-align:center;
    padding:10px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:15px;
    font-weight:bold;
}

.banner{
    background:#ddd;
    text-align:center;
    padding:50px;
}

.products{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    padding:20px;
}

.card{
    width:250px;
    background:white;
    margin:15px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,.2);
    overflow:hidden;
    text-align:center;
}

.card img{
    width:100%;
    height:220px;
}

.card h3{
    margin:10px;
}

.price{
    color:green;
    font-size:20px;
    margin:10px;
}

button{
    background:#007bff;
    color:white;
    border:none;
    padding:10px 20px;
    margin:15px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#0056b3;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
}
</style>
</head>

<body>

<header>
<h1>reena Online Shop</h1>
<p>Best Products at Best Prices</p>
</header>

<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">About</a>
<a href="#">Contact</a>
</nav>

<section class="banner">
<h2>Welcome to reena Store</h2>
<p>Shop the latest products online.</p>
</section>

<section class="products">

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Smart Phone</h3>
<p class="price">₹15,999</p>
<button>Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Laptop</h3>
<p class="price">₹45,999</p>
<button>Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Headphones</h3>
<p class="price">₹1,999</p>
<button>Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x220" alt="Product">
<h3>Smart Watch</h3>
<p class="price">₹3,499</p>
<button>Add to Cart</button>
</div>

</section>

<footer>
<p>© 2026 My Online Shop | All Rights Reserved</p>
</footer>

</body>
</html>
